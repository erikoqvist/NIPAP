{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "name": "nipapd",
            "request": "launch",
            "program": "${workspaceFolder}/nipap/nipap/nipapd.py",
            "args": [
                "--debug",
                "--foreground",
                "--auto-install-db",
                "--auto-upgrade-db",
                "--no-pid-file"
            ]
        },
        {
            "name": "nipap-www",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "nipap-www/nipapwww/__init__.py",
                "FLASK_DEBUG": "1",
                "FLASK_ENV": "development"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload",
                "--host=0.0.0.0"
            ],
            "jinja": true,
            "autoStartBrowser": false
        }
    ]
}